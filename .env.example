# Optional — caches Sanity content reads (WiFi, Services, Places, Amenities,
# Request Types, Food Menu) so guest page loads don't hit Sanity every time.
# Leave blank and the app works exactly the same, just without the cache.
# Create a free Redis database at https://console.upstash.com and paste its
# REST URL/token here.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
